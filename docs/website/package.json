{
  "name": "ai-projects-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Projects documentation website; reads canonical guides and unchanged sibling tutorials.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs && node tests/projects-browser.mjs && node tests/videos-browser.mjs && node tests/syntax-browser.mjs",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "test:collections": "node tests/collections-browser.mjs"
  },
  "dependencies": {
    "@mdit/plugin-katex": "^1.1.3",
    "gray-matter": "^4.0.3",
    "highlight.js": "11.12.0",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-container": "^4.0.0",
    "mermaid": "^11.17.2",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  }
}
